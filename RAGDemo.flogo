    {
      "id": "flow:EMS-Document-Trigger",
      "data": {
        "note": {
          "author": {
            "name": "VS code user",
            "userId": "vscode"
          },
          "content": "This flow can receive a notification with multiple documents and will iterate over each document in the ingestDocument activity. \nSubflow IngestDocumet is invoked for each flow induvidually",
          "createAt": 1790326638351,
          "lastUpdatedAt": 1790326638351,
          "title": "Flow Note"
        },
        "name": "EMS-Document-Trigger",
        "description": "Main flow to ingest new/changed document triggerd by notification on EMS topic",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogStart",
            "type": "label",
            "label": "StartActivity to CopyOfLogParser"
          },
          {
            "id": 2,
            "from": "LogStart",
            "to": "ParseJSON",
            "type": "label",
            "label": "LogStart to ParseJSON"
          },
          {
            "id": 3,
            "from": "ParseJSON",
            "to": "LogParser",
            "type": "label",
            "label": "ParseJSON to LogParser"
          },
          {
            "id": 4,
            "from": "LogParser",
            "to": "IngestDocument",
            "type": "label",
            "label": "LogParser to StartaSubFlow"
          },
          {
            "id": 5,
            "from": "IngestDocument",
            "to": "LogIngestionResult",
            "type": "label",
            "label": "IngestDocument to CopyOfLogParser"
          },
          {
            "id": 6,
            "from": "LogIngestionResult",
            "to": "EMSAcknowledge",
            "type": "label",
            "label": "CopyOfLogParser to EMSAcknowledge"
          },
          {
            "id": 7,
            "from": "EMSAcknowledge",
            "to": "Return",
            "type": "label",
            "label": "EMSAcknowledge to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogStart",
            "name": "LogStart",
            "description": "Simple SubFlow Activity",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:Logger",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "logMessage": "=$flow.message"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}",
                    "fe_metadata": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseJSON",
            "name": "ParseJSON",
            "description": "Parses JSON string into JSON object",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$flow.message"
              },
              "schemas": {
                "output": {
                  "jsonObject": "schema://singleFile"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogParser",
            "name": "LogParser",
            "description": "Simple SubFlow Activity",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:Logger",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "logMessage": "=string.concat(\"Message parsed: \",coerce.toString($activity[ParseJSON].jsonObject))"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}",
                    "fe_metadata": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "IngestDocument",
            "name": "IngestDocument",
            "description": "Simple SubFlow Activity",
            "note": {
              "author": {
                "name": "VS code user",
                "userId": "vscode"
              },
              "content": "Iterate over document and invoke for each document the Ingest process.",
              "createAt": 1790254282493,
              "lastUpdatedAt": 1790260599040,
              "title": "IngestDocument"
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:IngestDocument",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "file": {
                  "mapping": {
                    "createdTime": "=$activity[ParseJSON].jsonObject.createdTime",
                    "eventType": "=$activity[ParseJSON].jsonObject.eventType",
                    "fileId": "=$activity[ParseJSON].jsonObject.fileId",
                    "fileFullPath": "=$activity[ParseJSON].jsonObject.fileFullPath",
                    "fileName": "=$activity[ParseJSON].jsonObject.fileName",
                    "modifiedTime": "=$activity[ParseJSON].jsonObject.modifiedTime",
                    "collectionName": "=$property[\"VECTORSTORE.COLLECTIONNAME\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"FileMessage\",\"type\":\"object\",\"properties\":{\"file\":{\"type\":\"object\",\"properties\":{\"createdTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file event was created.\"},\"eventType\":{\"type\":\"string\",\"description\":\"The type of event (e.g., CREATED).\"},\"fileId\":{\"type\":\"integer\",\"description\":\"Unique identifier for the file.\"},\"fileFullPath\":{\"type\":\"string\",\"format\":\"uri\",\"description\":\"Fullpath and filename to access the file.\"},\"fileName\":{\"type\":\"string\",\"description\":\"Name of the file.\"},\"modifiedTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was last modified.\"},\"collectionName\":{\"type\":\"string\",\"description\":\"Name of the VectorStore table.\"}},\"required\":[\"createdTime\",\"eventType\",\"fileId\",\"fileFullPath\",\"fileName\",\"modifiedTime\"]}},\"required\":[\"file\"]}",
                    "fe_metadata": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"FileMessage\",\"type\":\"object\",\"properties\":{\"file\":{\"type\":\"object\",\"properties\":{\"createdTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file event was created.\"},\"eventType\":{\"type\":\"string\",\"description\":\"The type of event (e.g., CREATED).\"},\"fileId\":{\"type\":\"integer\",\"description\":\"Unique identifier for the file.\"},\"fileFullPath\":{\"type\":\"string\",\"format\":\"uri\",\"description\":\"Fullpath and filename to access the file.\"},\"fileName\":{\"type\":\"string\",\"description\":\"Name of the file.\"},\"modifiedTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was last modified.\"},\"collectionName\":{\"type\":\"string\",\"description\":\"Name of the VectorStore table.\"}},\"required\":[\"createdTime\",\"eventType\",\"fileId\",\"fileFullPath\",\"fileName\",\"modifiedTime\"]}},\"required\":[\"file\"]}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"FileMessage\",\"type\":\"object\",\"properties\":{\"output\":{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"string\",\"description\":\"ResultCode\"},\"message\":{\"type\":\"string\",\"description\":\"ResultMessage\"}},\"required\":[\"code\"]}}}",
                    "fe_metadata": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"FileMessage\",\"type\":\"object\",\"properties\":{\"output\":{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"string\",\"description\":\"ResultCode\"},\"message\":{\"type\":\"string\",\"description\":\"ResultMessage\"}},\"required\":[\"code\"]}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogIngestionResult",
            "name": "LogIngestionResult",
            "description": "Simple SubFlow Activity",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:Logger",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "logMessage": "=coerce.toString($activity[IngestDocument])"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}",
                    "fe_metadata": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "EMSAcknowledge",
            "name": "EMSAcknowledge",
            "description": "EMS acknowledge activity acknowledges message in explicit client ack mode",
            "activity": {
              "ref": "#acknowledge"
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Simple Return Activity",
            "activity": {
              "ref": "#actreturn"
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "message",
              "type": "string"
            },
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"destination\":{\"type\":\"string\"},\"replyTo\":{\"type\":\"string\"},\"deliveryMode\":{\"type\":\"string\"},\"messageID\":{\"type\":\"string\"},\"timestamp\":{\"type\":\"integer\"},\"expiration\":{\"type\":\"integer\"},\"reDelivered\":{\"type\":\"boolean\"},\"priority\":{\"type\":\"integer\"},\"correlationID\":{\"type\":\"string\"}}"
              }
            },
            {
              "name": "messageProperties",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"property\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}"
              }
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"ReceiveEMSMessage\",\"properties\":{\"message\":{\"type\":\"string\",\"required\":false},\"headers\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"destination\":{\"type\":\"string\"},\"replyTo\":{\"type\":\"string\"},\"deliveryMode\":{\"type\":\"string\"},\"messageID\":{\"type\":\"string\"},\"timestamp\":{\"type\":\"integer\"},\"expiration\":{\"type\":\"integer\"},\"reDelivered\":{\"type\":\"boolean\"},\"priority\":{\"type\":\"integer\"},\"correlationID\":{\"type\":\"string\"}}},\"messageProperties\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"property\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}}}"
          }
        }
      }
    },
    {
      "id": "flow:PublishFileTriggerMessage",
      "data": {
        "name": "PublishFileTriggerMessage",
        "description": "DEV Tool to manually publish new/changed file notification on EMS",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "EMSSendMessage",
            "type": "label",
            "label": "StartActivity to EMSSendMessage"
          },
          {
            "id": 2,
            "from": "EMSSendMessage",
            "to": "Return",
            "type": "label",
            "label": "EMSSendMessage to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "EMSSendMessage",
            "name": "EMSSendMessage",
            "description": "This activity sends message to the specified EMS destination",
            "activity": {
              "ref": "#sendmessage",
              "settings": {
                "connection": "conn://e7a79509-003b-45c6-acb2-2816db8c4029",
                "destinationType": "=$property[\"EMS.DOCUMENTTRIGGER.DESTINATIONTYPE\"]",
                "settingDestination": "=$property[\"EMS.DOCUMENTTRIGGER.DESTINATION\"]",
                "deliveryDelay": 0
              },
              "input": {
                "message": "=coerce.toString($flow.body)",
                "destination": ""
              },
              "schemas": {
                "input": {
                  "headers": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"correlationID\":{\"type\":\"string\"},\"replyTo\":{\"type\":\"string\"},\"deliveryMode\":{\"type\":\"string\"},\"expiration\":{\"type\":\"integer\"},\"priority\":{\"type\":\"integer\"}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"correlationID\":{\"type\":\"string\"},\"replyTo\":{\"type\":\"string\"},\"deliveryMode\":{\"type\":\"string\"},\"expiration\":{\"type\":\"integer\"},\"priority\":{\"type\":\"integer\"}}}"
                  },
                  "messageProperties": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"property\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"property\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Simple Return Activity",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "message": "=string.concat(\"messageId: \",$activity[EMSSendMessage].messageId)"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfSwiRU1TU2VuZE1lc3NhZ2UiOnsieCI6MjcwLCJ5Ijo4OH0sIlJldHVybiI6eyJ4Ijo1OTQsInkiOjg1fX0=",
        "metadata": {
          "input": [
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "body",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"createdTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was created\"},\"eventType\":{\"type\":\"string\",\"enum\":[\"CREATED\",\"MODIFIED\"],\"description\":\"Type of event that triggered the payload\"},\"fileId\":{\"type\":\"integer\",\"description\":\"The internal item ID of the file in SharePoint\"},\"fileLink\":{\"type\":\"string\",\"format\":\"uri\",\"description\":\"Direct web link to access the file\"},\"fileName\":{\"type\":\"string\",\"description\":\"The name with extension of the file (e.g., Document.docx)\"},\"filePath\":{\"type\":\"string\",\"description\":\"The full path of the file in SharePoint\"},\"modifiedTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was last modified\"}}"
              }
            },
            {
              "name": "requestURI",
              "type": "string"
            },
            {
              "name": "method",
              "type": "string"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "message",
              "type": "string"
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"ReceiveHTTPMessage\",\"properties\":{\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"body\":{\"type\":\"object\",\"required\":[\"createdTime\",\"eventType\",\"fileId\",\"fileLink\",\"fileName\",\"filePath\",\"modifiedTime\"],\"properties\":{\"createdTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was created\"},\"eventType\":{\"type\":\"string\",\"enum\":[\"CREATED\",\"MODIFIED\"],\"description\":\"Type of event that triggered the payload\"},\"fileId\":{\"type\":\"integer\",\"description\":\"The internal item ID of the file in SharePoint\"},\"fileLink\":{\"type\":\"string\",\"format\":\"uri\",\"description\":\"Direct web link to access the file\"},\"fileName\":{\"type\":\"string\",\"description\":\"The name with extension of the file (e.g., Document.docx)\"},\"filePath\":{\"type\":\"string\",\"description\":\"The full path of the file in SharePoint\"},\"modifiedTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was last modified\"}}},\"requestURI\":{\"type\":\"string\",\"required\":false},\"method\":{\"type\":\"string\",\"required\":false}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:Logger",
      "data": {
        "name": "Logger",
        "description": "Subflow: Logger",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogMessage",
            "type": "label",
            "label": "StartActivity to LogMessage"
          },
          {
            "id": 2,
            "from": "LogMessage",
            "to": "Return",
            "type": "label",
            "label": "LogMessage to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"**** \",$flowctx[\"ParentFlowName\"],\" **** - \",$flow.logMessage )",
                "logLevel": {
                  "@conditional": [
                    {
                      "string.length($flow.logLevel)>0": "=$flow.logLevel"
                    }
                  ]
                },
                "loggerName": "",
                "fieldPrefix": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Simple Return Activity",
            "activity": {
              "ref": "#actreturn"
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfSwiTG9nTWVzc2FnZSI6eyJ4IjoyNzQsInkiOjkzfSwiUmV0dXJuIjp7IngiOjUxNywieSI6OTV9fQ==",
        "metadata": {
          "input": [
            {
              "name": "logMessage",
              "type": "string"
            },
            {
              "name": "logLevel",
              "type": "string"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}"
          }
        }
      }
    },
    {
      "id": "flow:IngestDocument",
      "data": {
        "name": "IngestDocument",
        "description": "Subflow: Ingest document into vectorstore",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogStart",
            "type": "label",
            "label": "StartActivity to StartaSubFlow"
          },
          {
            "id": 2,
            "from": "LogStart",
            "to": "ChunkAndEmbedDocuments_Preview",
            "type": "label",
            "label": "LogStart to ChunkAndEmbedDocuments_Preview"
          },
          {
            "id": 3,
            "from": "ChunkAndEmbedDocuments_Preview",
            "to": "Mapper",
            "type": "label",
            "label": "ChunkAndEmbedDocuments_Preview to Mapper"
          },
          {
            "id": 4,
            "from": "Mapper",
            "to": "ActiveSpacesVectorUpsert",
            "type": "label",
            "label": "Mapper to ActiveSpacesVectorUpsert"
          },
          {
            "id": 5,
            "from": "ActiveSpacesVectorUpsert",
            "to": "UpsertLog",
            "type": "label",
            "label": "ActiveSpacesVectorUpsert to CopyOfStartaSubFlow"
          },
          {
            "id": 6,
            "from": "UpsertLog",
            "to": "ReturnOk",
            "type": "label",
            "label": "CopyOfStartaSubFlow to ReturnOk"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogStart",
            "name": "LogStart",
            "description": "Simple SubFlow Activity",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:Logger",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "logMessage": "=coerce.toString($flow.file)"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}",
                    "fe_metadata": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ChunkAndEmbedDocuments_Preview",
            "name": "ChunkAndEmbedDocuments_Preview",
            "description": "Split text or files into chunks and turn each chunk into an embedding vector. This functionality is in preview stage and not recommended for production use.",
            "activity": {
              "ref": "#chunkandembeddocuments",
              "settings": {
                "contentSource": "File Paths",
                "fileEncoding": "UTF-8",
                "maxFileSizeMB": 25,
                "onFileError": "Fail",
                "chunkingStrategy": "Recursive",
                "chunkSize": 3200,
                "chunkOverlap": 1600,
                "delimiterIsRegex": false,
                "separators": "\\n\\n,\\n,",
                "delimiter": "",
                "markdownHeadingLevel": 2,
                "minChunkSize": 0,
                "embeddingProvider": "OpenAI",
                "embeddingModel": "text-embedding-3-small",
                "dimensions": 0,
                "requestTimeoutSeconds": 60
              },
              "input": {
                "text": "",
                "documentId": "",
                "apiKey": "=$property[\"OPENAI.API_KEY\"]",
                "baseUrl": "=$property[\"OPENAI.BASE_URL\"]",
                "filePaths": "=array.create($flow.file.fileFullPath)"
              },
              "schemas": {
                "output": {
                  "embeddings": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"index\":{\"type\":\"number\"},\"text\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"startOffset\":{\"type\":\"number\"},\"endOffset\":{\"type\":\"number\"},\"charCount\":{\"type\":\"number\"},\"headings\":{\"type\":\"array\",\"items\":{}},\"metadata\":{\"type\":\"object\",\"properties\":{}},\"embedding\":{\"type\":\"array\",\"items\":{}},\"dimensions\":{\"type\":\"number\"}}}}",
                    "fe_metadata": "[{\r\n  \"id\": \"\",\r\n  \"index\": 0,\r\n  \"text\": \"\",\r\n  \"source\": \"\",\r\n  \"startOffset\": 0,\r\n  \"endOffset\": 0,\r\n  \"charCount\": 0,\r\n  \"headings\": [],\r\n  \"metadata\": {},\r\n  \"embedding\": [],\r\n  \"dimensions\": 0\r\n}]"
                  },
                  "skippedFiles": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"}}}}",
                    "fe_metadata": "[{\"path\": \"\", \"reason\": \"\"}]"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Mapper",
            "name": "Mapper",
            "description": "Mapper Activity",
            "type": "iterator",
            "settings": {
              "iterate": "=$activity[ChunkAndEmbedDocuments_Preview].embeddings",
              "accumulate": true
            },
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "id": "=$iteration[value].index",
                    "content": "=$iteration[value].text",
                    "metadata": "=coerce.toString($iteration[value].metadata)",
                    "embedding": {
                      "@foreach($iteration[value].embedding,embedding)": {
                        "=": "$loop"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"id\": { \"type\": \"integer\" },\r\n    \"content\": { \"type\": \"string\" },\r\n    \"embedding\": { \"type\": \"array\" },\r\n    \"metadata\": { \"type\": \"string\" }\r\n  }\r\n}",
                    "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"id\": { \"type\": \"integer\" },\r\n    \"content\": { \"type\": \"string\" },\r\n    \"embedding\": { \"type\": \"array\" },\r\n    \"metadata\": { \"type\": \"string\" }\r\n  }\r\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"id\": {\n      \"type\": \"integer\"\n    },\n    \"content\": {\n      \"type\": \"string\"\n    },\n    \"embedding\": {\n      \"type\": \"array\"\n    },\n    \"metadata\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"id\": {\n      \"type\": \"integer\"\n    },\n    \"content\": {\n      \"type\": \"string\"\n    },\n    \"embedding\": {\n      \"type\": \"array\"\n    },\n    \"metadata\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ActiveSpacesVectorUpsert",
            "name": "ActiveSpacesVectorUpsert",
            "description": "This activity writes rows containing vector embeddings to a TIBCO ActiveSpaces Grid table",
            "type": "iterator",
            "settings": {
              "iterate": "=$activity[Mapper]",
              "accumulate": false,
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorupsert",
              "settings": {
                "asConnection": "conn://399d3330-b60f-46f4-8f8d-1c8b2ed973c6",
                "writeMode": "Replace",
                "tableName": "=$property[\"VECTORSTORE.COLLECTIONNAME\"]"
              },
              "input": {
                "data": {
                  "mapping": {
                    "id": "=$iteration[value].output.id",
                    "content": "=$iteration[value].output.content",
                    "embedding": {
                      "@foreach($iteration[value].output.embedding,embedding)": {
                        "=": "$loop"
                      }
                    },
                    "metadata": "=$iteration[value].output.metadata"
                  }
                }
              },
              "schemas": {
                "input": {
                  "data": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"},\"content\":{\"type\":\"string\"},\"embedding\":{\"type\":\"array\"},\"metadata\":{\"type\":\"string\"}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"},\"content\":{\"type\":\"string\"},\"embedding\":{\"type\":\"array\"},\"metadata\":{\"type\":\"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "UpsertLog",
            "name": "UpsertLog",
            "description": "Simple SubFlow Activity",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:Logger",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "logMessage": "=string.concat(coerce.toString($activity[ActiveSpacesVectorUpsert].rowCount), \" Embeddings stored to vectorstore. \")"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}",
                    "fe_metadata": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnOk",
            "name": "ReturnOk",
            "description": "Simple Return Activity",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "output": {
                    "mapping": {
                      "code": "OK",
                      "message": "=$flow.file.fileFullPath"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "file",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"createdTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file event was created.\"},\"eventType\":{\"type\":\"string\",\"description\":\"The type of event (e.g., CREATED).\"},\"fileId\":{\"type\":\"integer\",\"description\":\"Unique identifier for the file.\"},\"fileFullPath\":{\"type\":\"string\",\"format\":\"uri\",\"description\":\"Fullpath and filename to access the file.\"},\"fileName\":{\"type\":\"string\",\"description\":\"Name of the file.\"},\"modifiedTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was last modified.\"},\"collectionName\":{\"type\":\"string\",\"description\":\"Name of the VectorStore table.\"}}"
              }
            }
          ],
          "output": [
            {
              "name": "output",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"code\":{\"type\":\"string\",\"description\":\"ResultCode\"},\"message\":{\"type\":\"string\",\"description\":\"ResultMessage\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"FileMessage\",\"type\":\"object\",\"properties\":{\"file\":{\"type\":\"object\",\"properties\":{\"createdTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file event was created.\"},\"eventType\":{\"type\":\"string\",\"description\":\"The type of event (e.g., CREATED).\"},\"fileId\":{\"type\":\"integer\",\"description\":\"Unique identifier for the file.\"},\"fileFullPath\":{\"type\":\"string\",\"format\":\"uri\",\"description\":\"Fullpath and filename to access the file.\"},\"fileName\":{\"type\":\"string\",\"description\":\"Name of the file.\"},\"modifiedTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was last modified.\"},\"collectionName\":{\"type\":\"string\",\"description\":\"Name of the VectorStore table.\"}},\"required\":[\"createdTime\",\"eventType\",\"fileId\",\"fileFullPath\",\"fileName\",\"modifiedTime\"]}},\"required\":[\"file\"]}",
            "output": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"FileMessage\",\"type\":\"object\",\"properties\":{\"output\":{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"string\",\"description\":\"ResultCode\"},\"message\":{\"type\":\"string\",\"description\":\"ResultMessage\"}},\"required\":[\"code\"]}}}"
          }
        }
      }
    }
  ],
