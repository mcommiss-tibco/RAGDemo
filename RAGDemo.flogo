  "contrib": "",
  "metadata": {
    "endpoints": [
      {
        "protocol": "http",
        "port": "19091",
        "spec": {
          "name": "RAGdemo",
          "version": "1.0.0"
        },
        "title": "ReceiveHTTPMessage",
        "swagger": {
          "swagger": "2.0",
          "info": {
            "title": "RAGdemo",
            "version": "1.0.0",
            "description": "Simple REST Trigger"
          },
          "paths": {
            "/fetch-file": {
              "post": {
                "summary": "PublishFileTriggerMessage",
                "operationId": "post_fetch-file",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "type": "string"
                  },
                  {
                    "name": "body",
                    "in": "body",
                    "description": "request body parameter",
                    "required": true,
                    "schema": {
                      "$ref": "#/definitions/schema1"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Rest Response",
                    "schema": {
                      "type": "string"
                    }
                  }
                },
                "description": "DEV Tool to manually publish new/changed file notification on EMS",
                "consumes": [
                  "application/json"
                ]
              }
            }
          },
          "definitions": {
            "schema1": {
              "type": "object",
              "required": [
                "createdTime",
                "eventType",
                "fileId",
                "fileLink",
                "fileName",
                "filePath",
                "modifiedTime"
              ],
              "properties": {
                "createdTime": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Timestamp when the file was created"
                },
                "eventType": {
                  "type": "string",
                  "enum": [
                    "CREATED",
                    "MODIFIED"
                  ],
                  "description": "Type of event that triggered the payload"
                },
                "fileId": {
                  "type": "integer",
                  "description": "The internal item ID of the file in SharePoint"
                },
                "fileLink": {
                  "type": "string",
                  "format": "uri",
                  "description": "Direct web link to access the file"
                },
                "fileName": {
                  "type": "string",
                  "description": "The name with extension of the file (e.g., Document.docx)"
                },
                "filePath": {
                  "type": "string",
                  "description": "The full path of the file in SharePoint"
                },
                "modifiedTime": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Timestamp when the file was last modified"
                }
              }
            }
          }
        }
      },
      {
        "protocol": "http",
        "port": "18081",
        "title": "MCPServer",
        "type": "public"
      }
    ],
    "flogoVersion": "2.26.8"
  }
