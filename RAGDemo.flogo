{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/project-flogo/flow/activity/subflow",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/activity/chunkandembeddocuments",
    "github.com/tibco/flogo-activespaces/src/app/ActiveSpaces/activity/vectorsearch",
    "github.com/tibco/flogo-general/src/app/General/activity/mapper",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-general/src/app/General/activity/parsejson",
    "github.com/tibco/flogo-ems/src/app/EMS/activity/acknowledge",
    "github.com/tibco/flogo-ems/src/app/EMS/activity/sendmessage",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/flogo-activespaces/src/app/ActiveSpaces/activity/vectorupsert",
    "github.com/tibco/flogo-ems/src/app/EMS/trigger/receivemessage",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/tibco/flogo-general/src/app/General/trigger/rest",
    "github.com/project-flogo/contrib/function/string",
    "github.com/project-flogo/contrib/function/array",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-activespaces/src/app/ActiveSpaces/connector/as",
    "github.com/tibco/flogo-ems/src/app/EMS/connector/ems"
  ],
  "name": "RAGdemo",
  "description": "RAGdemo (without azure starter)",
  "version": "1.0.1",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#receivemessage",
      "name": "receivemessage",
      "description": "This trigger receives messages from the EMS destination",
      "settings": {
        "connection": "conn://e7a79509-003b-45c6-acb2-2816db8c4029"
      },
      "id": "ReceiveEMSMessage",
      "handlers": [
        {
          "description": "Main flow to ingest new/changed document triggerd by notification on EMS topic",
          "settings": {
            "processingMode": "Sync",
            "destinationType": "=$property[\"EMS.DOCUMENTTRIGGER.DESTINATIONTYPE\"]",
            "destination": "=$property[\"EMS.DOCUMENTTRIGGER.DESTINATION\"]",
            "durableSubscriber": false,
            "sharedDurableSubscriber": false,
            "subscriptionName": "",
            "ackMode": "Auto",
            "messageSelector": "",
            "enableFlowLimit": false,
            "maxConcurrentMessages": 200
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:EMS-Document-Trigger"
            },
            "input": {
              "message": "=$.message",
              "headers": "=$.headers",
              "messageProperties": "=$.messageProperties"
            }
          },
          "schemas": {
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"destination\":{\"type\":\"string\"},\"replyTo\":{\"type\":\"string\"},\"deliveryMode\":{\"type\":\"string\"},\"messageID\":{\"type\":\"string\"},\"timestamp\":{\"type\":\"integer\"},\"expiration\":{\"type\":\"integer\"},\"reDelivered\":{\"type\":\"boolean\"},\"priority\":{\"type\":\"integer\"},\"correlationID\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"destination\":{\"type\":\"string\"},\"replyTo\":{\"type\":\"string\"},\"deliveryMode\":{\"type\":\"string\"},\"messageID\":{\"type\":\"string\"},\"timestamp\":{\"type\":\"integer\"},\"expiration\":{\"type\":\"integer\"},\"reDelivered\":{\"type\":\"boolean\"},\"priority\":{\"type\":\"integer\"},\"correlationID\":{\"type\":\"string\"}}}"
              },
              "messageProperties": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"property\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"property\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
              }
            }
          },
          "name": "EMS-Document-Trigger"
        }
      ]
    },
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Flogo MCP server for Agentic AI",
      "settings": {
        "serverName": "RAGDemo",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCPSERVER.HTTP-PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "MCPServer",
      "handlers": [
        {
          "description": "MCP Server to access AS VectorStore",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "RAGDemo",
            "handlerDescription": "Search the indexed document collection using semantic similarity. Use this tool when the user asks a question that may be answered from the indexed documents. The query should be a natural-language description of the information being sought. Results include the relevant document passages and metadata. Use filters when the user specifies a product, version, document type, etc.",
            "toolTitle": "DocumentRAG",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:MCPServerVectorStore"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"querytext\": {\n      \"type\": \"string\",\n      \"description\": \"Query to use to retrieve RAG data\"\n    }\n  },\n  \"required\": [\n    \"querytext\"\n  ],\n  \"additionalProperties\": false\n}",
                "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"querytext\": {\n      \"type\": \"string\",\n      \"description\": \"Query to use to retrieve RAG data\"\n    }\n  },\n  \"required\": [\n    \"querytext\"\n  ],\n  \"additionalProperties\": false\n}"
              }
            }
          },
          "name": "MCPServerVectorStore"
        }
      ]
    },
    {
      "ref": "#rest",
      "name": "tibco-wi-rest",
      "description": "Simple REST Trigger",
      "settings": {
        "port": 19091,
        "APISpecUpdate": true,
        "swagger": "spec://02661cb4",
        "swaggerVersion": "v2",
        "authenticationType": "None",
        "username": "",
        "password": "",
        "apiVersion": "1.0.0",
        "secureConnection": false,
        "serverKey": "",
        "caCertificate": ""
      },
      "id": "ReceiveHTTPMessage",
      "handlers": [
        {
          "description": "DEV Tool to manually publish new/changed file notification on EMS",
          "settings": {
            "APISpecPath": "/fetch-file",
            "Method": "POST",
            "reqType": "application/json",
            "Path": "/fetch-file",
            "OutputValidation": false
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:PublishFileTriggerMessage"
            },
            "input": {
              "body": "=$.body",
              "headers": "=$.headers"
            },
            "output": {
              "code": "=$.code",
              "message": "=$.message"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": false,
            "message": {}
          },
          "schemas": {
            "reply": {
              "responseBody": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}}"
              },
              "responseCodesSchema": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"number\"},\"responseType\":{\"type\":\"string\"}},\"required\":[\"code\",\"responseType\"]}}",
                "fe_metadata": "[{\"code\":200,\"responseType\":\"string\"},{\"code\":400,\"responseType\":\"string\"}]"
              }
            },
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Authorization\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
              },
              "body": {
                "type": "json",
                "value": "{\"type\":\"object\",\"required\":[\"createdTime\",\"eventType\",\"fileId\",\"fileLink\",\"fileName\",\"filePath\",\"modifiedTime\"],\"properties\":{\"createdTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was created\"},\"eventType\":{\"type\":\"string\",\"enum\":[\"CREATED\",\"MODIFIED\"],\"description\":\"Type of event that triggered the payload\"},\"fileId\":{\"type\":\"integer\",\"description\":\"The internal item ID of the file in SharePoint\"},\"fileLink\":{\"type\":\"string\",\"format\":\"uri\",\"description\":\"Direct web link to access the file\"},\"fileName\":{\"type\":\"string\",\"description\":\"The name with extension of the file (e.g., Document.docx)\"},\"filePath\":{\"type\":\"string\",\"description\":\"The full path of the file in SharePoint\"},\"modifiedTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was last modified\"}}}",
                "fe_metadata": "{\"type\":\"object\",\"required\":[\"createdTime\",\"eventType\",\"fileId\",\"fileLink\",\"fileName\",\"filePath\",\"modifiedTime\"],\"properties\":{\"createdTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was created\"},\"eventType\":{\"type\":\"string\",\"enum\":[\"CREATED\",\"MODIFIED\"],\"description\":\"Type of event that triggered the payload\"},\"fileId\":{\"type\":\"integer\",\"description\":\"The internal item ID of the file in SharePoint\"},\"fileLink\":{\"type\":\"string\",\"format\":\"uri\",\"description\":\"Direct web link to access the file\"},\"fileName\":{\"type\":\"string\",\"description\":\"The name with extension of the file (e.g., Document.docx)\"},\"filePath\":{\"type\":\"string\",\"description\":\"The full path of the file in SharePoint\"},\"modifiedTime\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"Timestamp when the file was last modified\"}}}"
              },
              "multipartFormData": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{}}"
              },
              "multipartForm": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{}}",
                "fe_metadata": "[]"
              }
            }
          },
          "name": "PublishFileTriggerMessage"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:MCPServerVectorStore",
      "data": {
        "name": "MCPServerVectorStore",
        "description": "MCP Server to access AS VectorStore",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogStart",
            "type": "label",
            "label": "StartActivity to LogStart"
          },
          {
            "id": 2,
            "from": "LogStart",
            "to": "ChunkAndEmbedDocuments_Preview",
            "type": "label",
            "label": "LogStart to ChunkAndEmbedDocuments_Preview"
          },
          {
            "id": 3,
            "from": "ChunkAndEmbedDocuments_Preview",
            "to": "ActiveSpacesVectorSearch",
            "type": "label",
            "label": "ChunkAndEmbedDocuments_Preview to ActiveSpacesVectorSearch"
          },
          {
            "id": 4,
            "from": "ActiveSpacesVectorSearch",
            "to": "logSearch",
            "type": "label",
            "label": "ActiveSpacesVectorSearch to CopyOflog"
          },
          {
            "id": 5,
            "from": "logSearch",
            "to": "Mapper",
            "type": "label",
            "label": "CopyOflog to Mapper"
          },
          {
            "id": 6,
            "from": "Mapper",
            "to": "logMapper",
            "type": "label",
            "label": "Mapper to StartaSubFlow"
          },
          {
            "id": 7,
            "from": "logMapper",
            "to": "Return",
            "type": "label",
            "label": "StartaSubFlow to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogStart",
            "name": "LogStart",
            "description": "Simple SubFlow Activity",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:Logger",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "logMessage": "=string.concat( \"querytext: \",$flow.arguments.querytext)"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}",
                    "fe_metadata": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ChunkAndEmbedDocuments_Preview",
            "name": "ChunkAndEmbedDocuments_Preview",
            "description": "Split text or files into chunks and turn each chunk into an embedding vector. This functionality is in preview stage and not recommended for production use.",
            "activity": {
              "ref": "#chunkandembeddocuments",
              "settings": {
                "contentSource": "Text",
                "fileEncoding": "UTF-8",
                "maxFileSizeMB": 25,
                "onFileError": "Fail",
                "chunkingStrategy": "Recursive",
                "chunkSize": 3200,
                "chunkOverlap": 1600,
                "delimiterIsRegex": false,
                "separators": "\\n\\n,\\n,",
                "delimiter": "",
                "markdownHeadingLevel": 2,
                "minChunkSize": 0,
                "embeddingProvider": "OpenAI",
                "embeddingModel": "text-embedding-3-small",
                "dimensions": "=$property[\"VECTORSTORE.DIMENSIONS\"]",
                "requestTimeoutSeconds": 60
              },
              "input": {
                "text": "=$flow.arguments.querytext",
                "documentId": "",
                "apiKey": "=$property[\"OPENAI.API_KEY\"]",
                "baseUrl": "=$property[\"OPENAI.BASE_URL\"]"
              },
              "schemas": {
                "output": {
                  "embeddings": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"index\":{\"type\":\"number\"},\"text\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"startOffset\":{\"type\":\"number\"},\"endOffset\":{\"type\":\"number\"},\"charCount\":{\"type\":\"number\"},\"headings\":{\"type\":\"array\",\"items\":{}},\"metadata\":{\"type\":\"object\",\"properties\":{}},\"embedding\":{\"type\":\"array\",\"items\":{}},\"dimensions\":{\"type\":\"number\"}}}}",
                    "fe_metadata": "[{\r\n  \"id\": \"\",\r\n  \"index\": 0,\r\n  \"text\": \"\",\r\n  \"source\": \"\",\r\n  \"startOffset\": 0,\r\n  \"endOffset\": 0,\r\n  \"charCount\": 0,\r\n  \"headings\": [],\r\n  \"metadata\": {},\r\n  \"embedding\": [],\r\n  \"dimensions\": 0\r\n}]"
                  },
                  "skippedFiles": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"}}}}",
                    "fe_metadata": "[{\"path\": \"\", \"reason\": \"\"}]"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ActiveSpacesVectorSearch",
            "name": "ActiveSpacesVectorSearch",
            "description": "This activity performs a similarity search against a VECTOR_FLOAT32 column in a TIBCO ActiveSpaces Grid table",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorsearch",
              "settings": {
                "asConnection": "conn://399d3330-b60f-46f4-8f8d-1c8b2ed973c6",
                "tableName": "=$property[\"VECTORSTORE.COLLECTIONNAME\"]",
                "vectorColumn": "embedding",
                "similarityFunction": "Cosine"
              },
              "input": {
                "filter": "",
                "maxResults": 5,
                "minScore": 0,
                "queryVector": {
                  "mapping": {
                    "@foreach($activity[ChunkAndEmbedDocuments_Preview].embeddings[0].embedding,embedding)": {
                      "=": "$loop"
                    }
                  }
                }
              },
              "schemas": {
                "output": {
                  "rows": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"embedding\":{\"type\":\"array\",\"items\":{\"type\":\"number\"}},\"id\":{\"type\":\"number\"},\"score\":{\"type\":\"number\"}},\"required\":[\"content\",\"embedding\",\"id\",\"score\"]}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"embedding\":{\"type\":\"array\",\"items\":{\"type\":\"number\"}},\"id\":{\"type\":\"number\"},\"score\":{\"type\":\"number\"}},\"required\":[\"content\",\"embedding\",\"id\",\"score\"]}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "logSearch",
            "name": "logSearch",
            "description": "Simple SubFlow Activity",
            "type": "iterator",
            "settings": {
              "iterate": "=$activity[ActiveSpacesVectorSearch].rows",
              "accumulate": false,
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:Logger",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "logMessage": "=coerce.toString($iteration[index])"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}",
                    "fe_metadata": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"LogProcess\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"logMessage\":{\"type\":\"string\"},\"logLevel\":{\"type\":\"string\"}},\"required\":[\"logMessage\"]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Mapper",
            "name": "Mapper",
            "description": "Mapper Activity",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "@foreach($activity[ActiveSpacesVectorSearch].rows,rows)": {
                      "content": "=$loop[rows].content",
                      "id": "=$loop[rows].id",
                      "score": "=$loop[rows].score"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"array\",\n    \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n            \"content\": {\n                \"type\": \"string\"\n            },\n           \n            \"id\": {\n                \"type\": \"number\"\n            },\n            \"score\": {\n                \"type\": \"number\"\n            }\n        },\n        \"required\": [\n            \"content\",\n            \"id\",\n            \"score\"\n        ]\n    }\n}",
                    "fe_metadata": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"array\",\n    \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n            \"content\": {\n                \"type\": \"string\"\n            },\n           \n            \"id\": {\n                \"type\": \"number\"\n            },\n            \"score\": {\n                \"type\": \"number\"\n            }\n        },\n        \"required\": [\n            \"content\",\n            \"id\",\n            \"score\"\n        ]\n    }\n}"
                  }
                },
                "output": {
