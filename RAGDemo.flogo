      "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\r\n  \"title\": \"SharePointFileEvent\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"createdTime\": {\r\n      \"type\": \"string\",\r\n      \"format\": \"date-time\"\r\n    },\r\n    \"eventType\": {\r\n      \"type\": \"string\",\r\n      \"enum\": [\"CREATED\", \"MODIFIED\"]\r\n    },\r\n    \"fileId\": {\r\n      \"type\": \"integer\"\r\n    },\r\n    \"fileFullPath\": {\r\n      \"type\": \"string\",\r\n      \"format\": \"uri\"\r\n    },\r\n    \"fileName\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"modifiedTime\": {\r\n      \"type\": \"string\",\r\n      \"format\": \"date-time\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"createdTime\",\r\n    \"eventType\",\r\n    \"fileId\",\r\n    \"fileFullPath\",\r\n    \"fileName\",\r\n    \"modifiedTime\"\r\n  ]\r\n}",
